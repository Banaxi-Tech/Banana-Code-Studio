{
  "name": "banana-code-studio",
  "version": "0.5.0",
  "description": "GUI for the Banana Code AI coding assistant",
  "homepage": "https://bananacode.sh",
  "author": {
    "name": "BanaxiTech",
    "email": "banaxitech@gmail.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.4.2",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.9.0"
  },
  "build": {
    "appId": "com.bananacode.studio",
    "productName": "Banana Code Studio",
    "icon": "assets/banana.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "zip",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Banana Code Studio uses the microphone to record voice prompts for transcription."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "BanaxiTech <banaxitech@gmail.com>"
    }
  }
}
